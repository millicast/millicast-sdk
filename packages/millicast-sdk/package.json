{
  "name": "@millicast/sdk",
  "version": "0.7.0",
  "description": "SDK for building a realtime broadcaster using the Millicast platform.",
  "keywords": [
    "sdk",
    "millicast",
    "webrtc",
    "realtime",
    "streaming"
  ],
  "main": "dist/millicast.js",
  "module": "dist/millicast.mjs",
  "browser": "dist/millicast.umd.js",
  "millicastdebug": "dist/millicast.debug.umd.js",
  "types": "dist/millicast.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc --build && vite build --config vite.config.debug.mjs && vite build && rollup -c",
    "build:watch": "vite build --watch",
    "build-docs": "jsdoc -c jsdoc.json -R ../../README.md",
    "start-docs": "pnpm run build-docs && serve docs",
    "test-unit": "pnpm run build && jest --testMatch \"**/unit/*.steps.js\"",
    "test-unit-coverage": "pnpm run build && jest --testMatch \"**/unit/*.steps.js\" --coverage",
    "test-e2e": "pnpm run build && jest --testMatch \"**/e2e/*.steps.js\" --verbose",
    "test-all": "pnpm run build && jest --testMatch \"**/*.steps.js\"",
    "test": "pnpm run test-all"
  },
  "babel": {
    "env": {
      "test": {
        "presets": [
          [
            "@babel/preset-env",
            {
              "targets": {
                "node": 12
              }
            }
          ]
        ]
      }
    }
  },
  "author": "Millicast, Inc.",
  "homepage": "https://github.com/millicast/millicast-sdk#readme",
  "license": "See in LICENSE file",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/millicast/millicast-sdk.git"
  },
  "dependencies": {
    "@dolbyio/webrtc-stats": "~1.0.4",
    "@types/node": "^24.0.0",
    "Base64": "^1.1.0",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "js-logger": "^1.6.1",
    "jsdoc-i18n-plugin": "^0.0.3",
    "jwt-decode": "^4.0.0",
    "re-emitter": "^1.1.4",
    "semantic-sdp": "^3.22.0",
    "transaction-manager": "^2.1.3",
    "ua-parser-js": "^2.0.10",
    "valibot": "^1.4.2"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/helpers": "^8.0.0",
    "@babel/plugin-transform-modules-commonjs": "^8.0.1",
    "@babel/plugin-transform-runtime": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@babel/runtime": "^8.0.0",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "babel-jest": "^30.4.1",
    "clean-jsdoc-theme": "^5.1.1",
    "core-js": "^3.50.0",
    "dotenv": "^17.4.2",
    "jest": "^30.4.2",
    "jest-cucumber": "^4.5.0",
    "jest-environment-jsdom": "^30.4.1",
    "jest-puppeteer": "^11.0.0",
    "jest-websocket-mock": "^2.5.0",
    "jsdoc": "^4.0.5",
    "jsdoc-export-default-interop": "^0.3.1",
    "mock-socket": "^9.0.3",
    "puppeteer": "^25.9.0",
    "rollup": "4.63.0",
    "rollup-plugin-cleanup": "^3.2.1",
    "rollup-plugin-dts": "^6.5.1",
    "serve": "^14.2.6",
    "typescript": "^7.0.2",
    "underscore": "^1.13.8",
    "vite": "^8.2.2"
  }
}
