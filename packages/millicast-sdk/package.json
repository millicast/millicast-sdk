{
  "name": "@millicast/sdk",
  "version": "0.7.0",
  "description": "SDK for building a realtime broadcaster using the Millicast platform.",
  "keywords": [
    "sdk",
    "millicast",
    "webrtc",
    "realtime",
    "streaming"
  ],
  "main": "./dist/index.esm.js",
  "module": "./dist/index.esm.js",
  "typings": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.esm.js",
      "require": "./dist/index.esm.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && rollup -c",
    "build-docs": "jsdoc -c jsdoc.json -R ../../README.md",
    "start-docs": "npm run build-docs && serve docs",
    "test-unit": "npm run build && jest --config jest.config.js --testMatch '**/unit/*.steps.js'",
    "test-unit-coverage": "npm run build && jest --config jest.config.js --testMatch '**/unit/*.steps.js' --coverage",
    "test-e2e": "npm run build && jest --config jest.config.js --testMatch '**/e2e/*.steps.js' --verbose",
    "test-all": "npm run build && jest --config jest.config.js --testMatch '**/*.(test|steps).[jt]s'",
    "test": "npm run test-all"
  },
  "babel": {
    "env": {
      "test": {
        "presets": [
          [
            "@babel/preset-env",
            {
              "targets": {
                "node": 12
              }
            }
          ]
        ]
      }
    }
  },
  "author": "Millicast, Inc.",
  "homepage": "https://github.com/millicast/millicast-sdk#readme",
  "license": "See in LICENSE file",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/millicast/millicast-sdk.git"
  },
  "devDependencies": {
    "babel-plugin-transform-import-meta": "^2.3.3"
  }
}
