{
  "name": "@millicast/sdk",
  "version": "0.7.0",
  "description": "SDK for building a realtime broadcaster using the Millicast platform.",
  "keywords": [
    "sdk",
    "millicast",
    "webrtc",
    "realtime",
    "streaming"
  ],
  "type": "module",
  "main": "./dist/millicast.umd.js",
  "module": "./dist/millicast.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/millicast.mjs",
      "require": "./dist/millicast.umd.js"
    }
  },
  "files": [
    "dist",
    "scripts"
  ],
  "scripts": {
    "build": "nx build @millicast/sdk",
    "build-docs": "typedoc",
    "build-docs:jsdoc": "jsdoc -c jsdoc.json -R ../../README.md",
    "start-docs": "npm run build-docs && serve docs",
    "test": "nx test @millicast/sdk",
    "test-unit": "nx test @millicast/sdk --testFile='unit'",
    "test-e2e": "nx run @millicast/sdk:test-e2e",
    "test-all": "nx test @millicast/sdk"
  },
  "babel": {
    "env": {
      "test": {
        "presets": [
          [
            "@babel/preset-env",
            {
              "targets": {
                "node": 18
              }
            }
          ]
        ]
      }
    }
  },
  "author": "Millicast, Inc.",
  "homepage": "https://github.com/millicast/millicast-sdk#readme",
  "license": "See in LICENSE file",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/millicast/millicast-sdk.git"
  },
  "devDependencies": {
    "babel-plugin-transform-import-meta": "^2.3.3"
  }
}