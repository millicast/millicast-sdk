{
    "compilerOptions": {
        "target": "ES2020",
        "composite": true,
        "incremental": true,
        "lib": ["ES2020", "DOM"], 
        "module": "ESNext", 
        "moduleResolution": "bundler",
        "emitDeclarationOnly": true,
        "outDir": "dist",
        "strict": false,
        "esModuleInterop": true,
        "allowSyntheticDefaultImports": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "allowJs": true,
        "checkJs": false,
        "declaration": true,
        "declarationMap": true, 
        "sourceMap": true,
        "resolveJsonModule": true, 
        "isolatedModules": true 
    },
  "include": [
    "./src/**/*.ts",
    "./src/**/*.js",
  ],
      "exclude": ["./node_modules/**/*"]
}
