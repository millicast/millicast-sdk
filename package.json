{
    "name": "root",
    "private": true,
    "engines": {
        "node": ">=24.15.0",
        "pnpm": ">=11.0.0"
    },
    "scripts": {
        "build": "pnpm -r run build",
        "build:sdk": "pnpm --filter @millicast/sdk run build:watch",
        "start:projects": "pnpm --filter millicast-viewer-demo run start",
        "delay": "node -e \"setTimeout(() => {}, 3000)\"",
        "start": "concurrently \"pnpm run build:sdk\" \"pnpm run delay && pnpm run start:projects\"",
        "start-all:projects": "pnpm -r run start",
        "start-all": "concurrently \"pnpm run build:sdk\" \"pnpm run delay && pnpm run start-all:projects\"",
        "test": "pnpm -r run test",
        "test-e2e": "pnpm -r run test-e2e",
        "build-docs": "pnpm -r run build-docs",
        "start-docs": "pnpm -r run start-docs",
        "lint-fix": "eslint . --fix"
    },
    "devDependencies": {
        "@changesets/cli": "^3.0.1",
        "@eslint/js": "^10.0.1",
        "concurrently": "^10.0.5",
        "eslint": "^10.9.1",
        "globals": "^17.0.0",
        "vite": "^8.2.2"
    },
    "packageManager": "pnpm@11.27.0+sha512.ad12821463bb143295f1fa3ecde77a6b9b97a7990386da800ff57bffc3964dc64b7b1c7559d5dbe5c337aea659ed9c8937d4370bd198ca2009bc6fa0249808e7"
}
