{
  "name": "@nx-millicast/source",
  "private": true,
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged",
      "pre-push": "./check-signature.sh"
    }
  },
  "lint-staged": {
    "**/*.js": [
      "eslint --fix"
    ]
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "nx run-many -t build --exclude=@nx-millicast/source",
    "build:sdk": "nx build @millicast/sdk --watch",
    "start:projects": "nx run-many -t start --projects=millicast-publisher-demo,millicast-viewer-demo --parallel",
    "start": "nx run-many -t start --projects=@millicast/sdk,millicast-publisher-demo,millicast-viewer-demo --parallel",
    "start-all": "nx run-many -t start --all --parallel",
    "test": "nx run-many -t test",
    "test-unit": "npm run test-unit --workspace=@millicast/sdk",
    "test-e2e": "npm run test-e2e --workspace=@millicast/sdk",
    "test-watch": "npm run test --workspace=@millicast/sdk -- --watch",
    "test-coverage": "npm run test --workspace=@millicast/sdk -- --coverage",
    "build-docs": "nx run @millicast/sdk:build-docs",
    "start-docs": "nx run-many -t start-docs",
    "publish": "nx release",
    "lint": "ESLINT_USE_FLAT_CONFIG=false nx lint @millicast/sdk",
    "lint-fix": "ESLINT_USE_FLAT_CONFIG=false nx lint @millicast/sdk --fix",
    "lint-all": "ESLINT_USE_FLAT_CONFIG=false nx run-many -t lint"
  },
  "dependencies": {
    "@dolbyio/webrtc-stats": "^1.0.4",
    "@types/ua-parser-js": "^0.7.39",
    "buffer": "^6.0.3",
    "events": "^3.3.0",
    "js-base64": "^3.7.8",
    "js-logger": "^1.6.1",
    "jsdoc-i18n-plugin": "^0.0.3",
    "jwt-decode": "^4.0.0",
    "re-emitter": "^1.1.4",
    "recast": "^0.23.11",
    "semantic-sdp": "^3.31.1",
    "transaction-manager": "^2.1.7",
    "tslib": "^2.8.1",
    "ua-parser-js": "^2.0.9",
    "valibot": "^1.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@babel/helpers": "^7.28.6",
    "@babel/plugin-transform-modules-commonjs": "^7.28.6",
    "@babel/plugin-transform-runtime": "^7.29.0",
    "@babel/preset-env": "^7.29.0",
    "@babel/runtime": "^7.28.6",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.2",
    "@maslick/radiaslider": "^1.9.8",
    "@nx/eslint": "^22.5.3",
    "@nx/eslint-plugin": "^22.5.3",
    "@nx/jest": "^22.5.3",
    "@nx/js": "^22.5.3",
    "@nx/vite": "^22.5.3",
    "@nx/web": "^22.5.3",
    "@nx/workspace": "^22.5.3",
    "@rollup/plugin-babel": "^7.0.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@swc-node/register": "^1.11.1",
    "@swc/core": "^1.15.11",
    "@swc/helpers": "^0.5.18",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.19.30",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "@vitest/ui": "^4.0.18",
    "babel-jest": "^30.2.0",
    "babel-plugin-transform-import-meta": "^2.3.3",
    "clean-jsdoc-theme": "^4.3.0",
    "concurrently": "^9.2.1",
    "core-js": "^3.48.0",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.12.1",
    "eslint-plugin-n": "^17.23.2",
    "eslint-plugin-promise": "^7.2.1",
    "husky": "^9.1.7",
    "install": "^0.13.0",
    "jest": "^30.2.0",
    "jest-cucumber": "^4.5.0",
    "jest-environment-jsdom": "^30.2.0",
    "jest-environment-node": "^30.2.0",
    "jest-puppeteer": "^11.0.0",
    "jest-websocket-mock": "^2.5.0",
    "jsdoc": "^4.0.5",
    "jsdoc-export-default-interop": "^0.3.1",
    "jsdom": "^28.1.0",
    "lint-staged": "^16.3.2",
    "mock-socket": "^9.3.1",
    "netlify-cli": "^24.0.1",
    "npm": "^8.19.4",
    "nx": "^22.5.3",
    "prettier": "^3.8.1",
    "puppeteer": "^24.36.1",
    "serve": "^14.2.5",
    "swc-loader": "0.2.7",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "underscore": "^1.13.7",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-node-polyfills": "^0.25.0",
    "vite-plugin-static-copy": "^3.2.0",
    "vitest": "^4.0.18"
  },
  "nx": {
    "includedTargets": [
      "test",
      "lint",
      "prepare"
    ]
  }
}
